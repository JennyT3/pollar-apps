NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxxxxxxxxxxxxxx

# The backend never calls the Pollar gateway for auth. The casera's identity
# is an offline admin token (hash stored on the Stall row, sent as
# X-Admin-Token). No secret key is required.

# Local SQLite by default (no external DB needed). For Vercel deploy, override
# these two in the Vercel dashboard (never commit a Turso URL/token):
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./prisma/dev.db